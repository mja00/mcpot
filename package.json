{
  "name": "minecraft-pot-network",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "libs": "pnpm --filter @mcpot/protocol --filter @mcpot/shared build",
    "daemon": "pnpm libs && node --experimental-transform-types --disable-warning=ExperimentalWarning apps/daemon/src/main.ts",
    "daemon:watch": "pnpm libs && node --experimental-transform-types --disable-warning=ExperimentalWarning --watch apps/daemon/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
