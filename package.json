{
  "name": "minecraft-pot-network",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "dev": "node scripts/dev.mjs",
    "libs": "pnpm --filter @mcpot/protocol --filter @mcpot/shared build",
    "daemon": "pnpm libs && node --experimental-transform-types --disable-warning=ExperimentalWarning apps/daemon/src/main.ts",
    "daemon:watch": "pnpm libs && node --experimental-transform-types --disable-warning=ExperimentalWarning --watch apps/daemon/src/main.ts",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "DATABASE_URL=postgres://mcpot:mcpot@localhost:55432/mcpot pnpm --filter @mcpot/server migrate",
    "serve": "pnpm libs && DATABASE_URL=postgres://mcpot:mcpot@localhost:55432/mcpot ADMIN_TOKEN=dev-admin-token PORT=8080 pnpm --filter @mcpot/server start",
    "web": "ADMIN_TOKEN=dev-admin-token VITE_API_TARGET=http://localhost:8080 pnpm --filter @mcpot/web dev",
    "token": "curl -s -XPOST http://localhost:8080/v1/admin/tokens -H 'authorization: Bearer dev-admin-token' -H 'content-type: application/json' -d '{}'",
    "probe": "pnpm libs && node scripts/probe.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.1.1",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vue-eslint-parser": "^9.4.3"
  }
}
