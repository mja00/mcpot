{
  "name": "@mcpot/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "start": "node --experimental-transform-types --disable-warning=ExperimentalWarning src/main.ts"
  },
  "dependencies": {
    "@mcpot/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.2.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "vitest": "^2.1.8"
  }
}
