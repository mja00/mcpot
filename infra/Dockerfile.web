# Dashboard image: build the Vue SPA, serve it with nginx, and proxy /v1 to the server service.
FROM node:24-slim AS builder
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
# `...` pulls workspace deps of web (@mcpot/shared) into the install.
RUN pnpm install --frozen-lockfile --filter @mcpot/web...
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web
# shared must be built first so vue-tsc can resolve its dist types.
RUN pnpm --filter @mcpot/shared build && pnpm --filter @mcpot/web build

FROM nginx:alpine
COPY infra/web-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
