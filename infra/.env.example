# Copy to infra/.env — compose auto-loads it from the compose file's directory, so no more
# inline env vars on the `docker compose` command line.

# Required
ADMIN_TOKEN=            # openssl rand -hex 24
ADMIN_PASSWORD=         # dashboard login password
SESSION_SECRET=         # openssl rand -hex 32

# Optional
#POSTGRES_PASSWORD=mcpot
#RETENTION_DAYS=90
#MCPOT_TAG=latest       # image tag for ghcr.io/mja00/mcpot-{server,web}

# Optional reporting sinks. Automatic reporting is enabled when a key is present unless disabled.
#ABUSEIPDB_KEY=
#WEBHOOK_URL=
#ABUSEIPDB_DAILY_LIMIT=5000      # Combined /report cap per UTC day for a contributor account
#ABUSEIPDB_AUTO_REPORT=true      # Report public IPs classified as scanners after 3+ hits in 24h
#ABUSEIPDB_AUTO_REPORT_MIN_SCORE=60
#ABUSEIPDB_AUTO_REPORT_MIN_HITS=3
#ABUSEIPDB_AUTO_REPORT_WINDOW_HOURS=24

# Optional GeoLite2 enrichment (free MaxMind account). Unset = no geo columns, everything else works.
#MAXMIND_ACCOUNT_ID=
#MAXMIND_LICENSE_KEY=
