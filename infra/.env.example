# Copy to infra/.env — compose auto-loads it from the compose file's directory, so no more
# inline env vars on the `docker compose` command line.

# Required
ADMIN_TOKEN=            # openssl rand -hex 24
ADMIN_PASSWORD=         # dashboard login password
SESSION_SECRET=         # openssl rand -hex 32

# Optional
#POSTGRES_PASSWORD=mcpot
#RETENTION_DAYS=90
#MCPOT_TAG=latest       # image tag for ghcr.io/mja00/mcpot-{server,web}

# Optional reporting sinks (reporting stays manual either way)
#ABUSEIPDB_KEY=
#WEBHOOK_URL=
